# At least one key is required. Leave the other empty: providers without a key are skipped.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Models to try in order, as provider:model.
AI_MODELS=groq:openai/gpt-oss-120b,google:gemini-3.5-flash,google:gemini-3.1-flash-lite

# Optional: chat queue limits (defaults shown)
MAX_CONCURRENT_TURNS=4
MAX_QUEUED_TURNS=20
MAX_QUEUE_WAIT_MS=15000